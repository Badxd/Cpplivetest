# /etc/cppgram-livebot.env  (owner root, mode 600). Copy to that path and fill in. Never commit real values.
# Every CHANGE_ME must be replaced; livebotctl refuses to start the bot while any remain.

# Telegram API credentials from https://my.telegram.org
TG_API_ID=CHANGE_ME
TG_API_HASH=CHANGE_ME

# Bot token from @BotFather (this is a dedicated test bot, not your production bot)
TG_BOT_TOKEN=CHANGE_ME

# Comma-separated Telegram user ids allowed to run commands. Only these accounts get a reply.
TG_ADMIN_IDS=CHANGE_ME

# Telegram data centre for the direct connection (1..5). 2 is the default.
TG_DC=2

# Paths (defaults shown; must match the directories install.sh creates)
TG_DATA_DIR=/var/lib/cppgram-livebot
TG_LOG_DIR=/var/log/cppgram-livebot

# Longest FLOOD_WAIT the library will sleep through and retry (seconds, 1..900)
TG_FLOOD_MAX_WAIT_SECONDS=60

# Library stage output on stderr (stage names and sizes only). 0 or 1.
TG_DEBUG=0

# Profile A: plain MTProxy secret (16 bytes). Leave all three unset to skip. Set all three or none.
# TG_PROXY_PLAIN_HOST=
# TG_PROXY_PLAIN_PORT=
# TG_PROXY_PLAIN_SECRET=

# Profile B: padded-intermediate ("dd") MTProxy secret (17 bytes, dd prefix). Set all three or none.
# TG_PROXY_DD_HOST=
# TG_PROXY_DD_PORT=
# TG_PROXY_DD_SECRET=
