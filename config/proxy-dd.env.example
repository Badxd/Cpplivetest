# Owner-approved dd proxy test. Use only with your own proxy and with CGLT_OWNER_APPROVED=1.
export CGLT_OWNER_APPROVED=1
export CGLT_PROXY_HOST=         # proxy host
export CGLT_PROXY_PORT=         # proxy port (1..65535)
export CGLT_PROXY_SECRET=       # dd secret: "dd" followed by 32 hex characters (34 characters in total)
