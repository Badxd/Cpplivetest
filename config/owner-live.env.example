# Owner live run. Fill in on the machine that runs the tests. Never commit the filled-in copy.
export CGLT_NETWORK_UNRESTRICTED=1
export TG_API_ID=               # your API id (integer)
export TG_API_HASH=             # your API hash (32 hex characters)
export TG_BOT_TOKEN=            # your bot token
